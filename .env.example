# Copia este fichero a .env.local y rellena los valores.
# .env.local está gitignorado: NUNCA se sube al repositorio.

# --- Sanity (panel de administración) ---
# projectId y dataset NO son secretos: van en el HTML de cualquier web con Sanity.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Token de ESCRITURA, sólo para la migración inicial (npm run migrate:sanity).
# Se crea en sanity.io/manage › API › Tokens con permiso "Editor". Es un secreto.
SANITY_API_WRITE_TOKEN=

# Secreto compartido con el webhook de Sanity que revalida la web al publicar.
# Cualquier cadena larga y aleatoria; el mismo valor va en sanity.io/manage › API › Webhooks.
SANITY_REVALIDATE_SECRET=

# --- Indexación en Google (candado) ---
# Sólo `true` permite que la web se indique, y además tiene que ser la rama `main` en el
# entorno de producción (ver lib/site-env.ts). Está a `false` a propósito: la web no puede
# aparecer en Google hasta que Manfisa valide las tablas de aleaciones, la capacidad y las
# certificaciones. Se activa en Vercel, en el proyecto `manfisa`, y no hace falta desplegar
# desde el repositorio para cambiarlo.
SITE_INDEXABLE=false
